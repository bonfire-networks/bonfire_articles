{#case current_user(@__context__)}
  {#match nil}
  {#match current_user}
    {#case load(current_user, @limit)}
      {#match [articles: articles]}
        <Bonfire.UI.Common.WidgetBlockLive
          widget_title={@widget_title || l("Recent Articles")}
          reset_cache_event="Bonfire.UI.Articles.WidgetRecentArticlesLive:reset_recent_articles"
          reset_cache_values={%{limit: @limit}}
          can_reset
          class="pt-card border-y border-y-secondary border-y-hair pb-2"
          title_class="flex items-center justify-between pb-card text-xs font-normal uppercase tracking-wide text-base-content px-base"
          empty={articles == []}
          empty_icon="ion:newspaper-outline"
          empty_message={l("No articles to read yet. Federated long-form posts will show up here as soon as they arrive.")}
        >
          <div class="flex flex-col bonfire-wrapper divide-secondary divide-hair !px-0 gap-4">
            {#for fp <- articles}
              {#case {e(fp, :activity, nil), e(fp, :activity, :object, nil) || e(fp, :object, nil),
                 e(fp, :activity, :subject, nil) || e(fp, :subject, nil)}}
                {#match {activity, object, subject} when not is_nil(object)}
                  {#case Bonfire.Files.split_primary_image(
                      e(activity, :files, nil) || e(object, :files, nil) || e(activity, :media, nil) ||
                        e(object, :media, nil)
                    )}
                    {#match {primary_image, _files}}
                      <Bonfire.UI.Articles.ArticleLive
                        object={object}
                        activity={activity}
                        subject={subject}
                        primary_image={primary_image}
                        image_position={@image_position}
                        showing_within={:widget}
                      />
                  {/case}
                {#match _}
              {/case}
            {/for}
          </div>
        </Bonfire.UI.Common.WidgetBlockLive>
    {/case}
{/case}
