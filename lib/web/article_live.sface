{!-- {#if @showing_within == :widget}
  <!-- Compact list-row layout for sidebar widgets; @image_position: :side or :bottom. Links navigate (no preview modal). -->
  <article
    data-id="activity_article"
    id={deterministic_dom_id(__MODULE__, id(@activity) || id(@object) || "no-id", "article_widget", @parent_id)}
    data-rendered={@showing_within}
    class={[
      "group py-4 first:pt-0 last:pb-0",
      "flex gap-3": @image_position == :side,
      "flex flex-col gap-2": @image_position == :bottom
    ]}
    >
    <div class="flex flex-col gap-1 flex-1 min-w-0">
      {#case @subject || e(@activity, :subject, nil) || e(@object, :created, :creator, nil)}
        {#match %{id: _} = author}
          <span class="text-caption font-medium text-primary uppercase tracking-wide truncate max-w-full">
            {e(author, :profile, :name, nil) || e(author, :character, :username, l("Unknown"))}
          </span>
        {#match _}
      {/case}

      <LinkLive
        to={path(@object)}
        class="text-body font-semibold link link-hover line-clamp-2 leading-snug text-base-content"
      >
        {rich(e(post_content(@object), :name, nil) || l("Untitled"))}
      </LinkLive>

      {#case e(post_content(@object), :summary, nil) || e(post_content(@object), :html_body, nil)}
        {#match description when is_binary(description) and description != ""}
          <p class="text-caption text-muted line-clamp-2 leading-relaxed">
            {Text.sentence_truncate(Text.text_only(description), 200, "...")}
          </p>
        {#match _}
      {/case}
    </div>

    {#case Media.media_url(@primary_image)}
      {#match url when is_binary(url)}
        <LinkLive
          to={path(@object)}
          class={[
            "block overflow-hidden rounded-box",
            "shrink-0 w-[82px] h-[82px]": @image_position == :side,
            "w-full aspect-video": @image_position == :bottom
          ]}
        >
          <Bonfire.UI.Common.LazyImage
            parent_id={deterministic_dom_id("article_widget_thumb", id(@activity) || id(@object))}
            class={[
              "object-cover transition-all",
              "w-[82px] h-[82px]": @image_position == :side,
              "w-full h-full": @image_position == :bottom
            ]}
            fallback_class="w-4 h-4 text-base-content/50"
            src={url}
            alt={Bonfire.Files.Media.media_alt(@primary_image)}
            fallback_icon="ion:newspaper-outline"
          />
        </LinkLive>
      {#match _}
    {/case}
  </article> --}
{#if @showing_within == :thread and @viewing_main_object}
  {!-- Reading view: title → lead → author → figure → body (borderless; thread card frames it). --}
  <article
    data-id="activity_article"
    id={deterministic_dom_id(
      __MODULE__,
      id(@activity) || id(@object) || "no-id",
      "article_reading",
      @parent_id
    )}
    phx-hook="Translate"
    data-translate-from={e(@object, :language, :locale, nil)}
    data-translate-to={to_string(Bonfire.Common.Localise.get_locale_id())}
    data-object-id={id(@object)}
    data-translate-server-available={to_string(
      Bonfire.Common.Extend.extension_enabled?(:bonfire_translation) and
        Bonfire.Translation.any_adapter_configured?(@__context__)
    )}
    data-rendered={@showing_within}
    data-main-object={@viewing_main_object}
    class="article flex flex-col gap-base max-w-full"
  >
    {#case e(post_content(@object), :name, nil)}
      {#match nil}
      {#match name}
        <h1
          data-role="name"
          class="translatable text-feature font-medium tracking-[-0.02em] text-base-content"
        >
          {rich(name)}
        </h1>
    {/case}

    {!-- Lead/summary, or the CW toggle --}
    {#case e(post_content(@object), :summary, nil)}
      {#match summary when is_binary(summary) and summary != ""}
        {#if @cw == true and e(post_content(@object), :html_body, nil)}
          <Bonfire.UI.Social.Activity.CWLive
            cw={@cw}
            activity_component_id={@activity_component_id}
            summary={summary}
          />
        {#else}
          <div
            data-role="summary"
            class="translatable text-intro-sm tracking-[-0.02em] text-base-content max-w-prose"
          >
            {rich(summary, skip_markdown: @is_remote, __unsafe__: !@is_remote)}
          </div>
        {/if}
      {#match _}
    {/case}

    {!-- Author --}
    {#case @subject}
      {#match nil}
      {#match author}
        <LinkLive
          to={path(author)}
          class="inline-flex items-center gap-half w-fit text-body text-base-content hover:text-primary transition-colors"
        >
          <Bonfire.UI.Common.AvatarLive
            ring
            parent_id="article_author"
            user_id={id(author)}
            src={Media.avatar_url(author)}
            class="w-[35px] h-[35px] rounded-full shrink-0"
          />
          <span class="font-medium">{e(author, :profile, :name, nil) || e(author, :character, :username, l("Unknown"))}</span>
        </LinkLive>
    {/case}

    {!-- Cover image --}
    {#case Media.media_url(@primary_image)}
      {#match url when is_binary(url)}
        <figure class="m-0">
          <div
            role="img"
            aria-label={Bonfire.Files.Media.media_alt(@primary_image)}
            data-id="article_cover"
            class="w-full aspect-[3/2] bg-center bg-no-repeat bg-cover overflow-hidden bg-placeholder"
            style={["background-image": "url('#{URI.encode(url)}')"]}
          >
            <span class="sr-only">{Bonfire.Files.Media.media_alt(@primary_image)}</span>
          </div>
          {#case Bonfire.Files.Media.media_label(@primary_image)}
            {#match nil}
            {#match caption}
              <figcaption class="mt-half text-caption text-muted italic">{rich(caption)}</figcaption>
          {/case}
        </figure>
      {#match _}
    {/case}

    {!-- Body (hidden behind the CW until revealed) --}
    <div id={"content_#{@activity_component_id}"} class={hidden: @cw == true}>
      {#case e(post_content(@object), :html_body, nil)}
        {#match nil}
        {#match html_body}
          <Bonfire.UI.Social.Activity.TruncatableContentLive
            html_body={html_body}
            activity={@activity}
            object={@object}
            parent_id={deterministic_dom_id(__MODULE__, id(@activity) || id(@object), nil, @parent_id)}
            object_type={:article}
            showing_within={@showing_within}
            viewing_main_object={@viewing_main_object}
            activity_inception={@activity_inception}
          />
      {/case}
    </div>

    <div class="flex items-center gap-2">
      <Bonfire.UI.Social.Activity.TranslateButtonsLive
        object={@object}
        activity={@activity}
        parent_id={@parent_id}
      />
    </div>
  </article>
{#else}
  {!-- Feed preview card. Root must be <div>, not <article>: the activity wrapper
       <article> carries the PreviewActivity hook whose nested-article guard
       (closest("article") !== el) would otherwise swallow the click. --}
  <div
    data-id="activity_article"
    id={deterministic_dom_id(
      __MODULE__,
      id(@activity) || id(@object) || "no-id",
      "article_container",
      @parent_id
    )}
    phx-hook="Translate"
    data-translate-from={e(@object, :language, :locale, nil)}
    data-translate-to={to_string(Bonfire.Common.Localise.get_locale_id())}
    data-object-id={id(@object)}
    data-translate-server-available={to_string(
      Bonfire.Common.Extend.extension_enabled?(:bonfire_translation) and
        Bonfire.Translation.any_adapter_configured?(@__context__)
    )}
    data-rendered={@showing_within}
    data-main-object={@viewing_main_object}
    class={
      "group article flex flex-col previewable_activity cursor-pointer bg-base-100 overflow-hidden -mx-card",
      "!mx-0 px-4": @showing_within == :widget
    }
  >
    <Bonfire.UI.Common.OpenExternalLinkLive
      id={deterministic_dom_id(__MODULE__, id(@activity) || id(@object), "link", @parent_id)}
      prompt_external_links={@showing_within == :flags}
    >
      <div class={
        "flex flex-col gap-content pt-card border-t-hair border-secondary px-card mt-card",
        "!border-0 !px-0 !mt-0 !pt-0": @showing_within == :widget
      }>
        {#case e(post_content(@object), :name, nil)}
          {#match nil}
          {#match name}
            {!-- plain (no link) so the click bubbles to the preview hook --}
            <div
              data-role="name"
              class="translatable text-display font-medium tracking-[-0.02em] leading-snug text-base-content"
            >
              {rich(name)}
            </div>
        {/case}

        {!-- Short excerpt only (never body text under a CW); full article opens in the preview modal --}
        {#case e(post_content(@object), :summary, nil) ||
            (@cw != true and e(post_content(@object), :html_body, nil))}
          {#match excerpt when is_binary(excerpt) and excerpt != ""}
            <div data-role="summary" class="text-body tracking-[-0.02em]">
              {maybe_truncate(Bonfire.Common.Text.text_only(excerpt), false, 280)}
            </div>
          {#match _}
        {/case}

        {!-- Author byline (only when it resolves to a real user) --}
        {#case @subject || e(@activity, :subject, nil) || e(@object, :created, :creator, nil)}
          {#match %{id: _} = author}
            <LinkLive
              to={path(author)}
              class="block w-fit mt-card text-body font-medium text-base-content hover:text-primary transition-colors"
            >
              {e(author, :profile, :name, nil) || e(author, :character, :username, l("Unknown"))}
            </LinkLive>
          {#match _}
        {/case}

        {!-- Cover image, placed after the text so the card stays title-first --}
        {#case Media.media_url(@primary_image)}
          {#match url when is_binary(url)}
            {!-- plain <div> (not <figure>/link), which the preview hook skips — keeps the image clickable --}
            <div class="mt-half">
              <div
                role="img"
                aria-label={Bonfire.Files.Media.media_alt(@primary_image)}
                data-id="article_cover"
                class="w-full aspect-[3/2] rounded-box overflow-hidden border-hair border-secondary bg-center bg-no-repeat bg-cover bg-placeholder"
                style={["background-image": "url('#{URI.encode(url)}')"]}
              >
                <span class="sr-only">{Bonfire.Files.Media.media_alt(@primary_image)}</span>
              </div>
              {#case Bonfire.Files.Media.media_label(@primary_image)}
                {#match nil}
                {#match caption}
                  <div class="pt-1.5 text-caption text-muted italic">{rich(caption)}</div>
              {/case}
            </div>
          {#match _}
        {/case}
      </div>

      <div class={"flex items-center gap-2 mt-2 pb-card px-card", "!px-0": @showing_within == :widget}>
        <Bonfire.UI.Social.Activity.TranslateButtonsLive
          object={@object}
          activity={@activity}
          parent_id={@parent_id}
        />
      </div>
    </Bonfire.UI.Common.OpenExternalLinkLive>
  </div>
{/if}
